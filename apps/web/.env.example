# Frontend build variables (public in the browser). Copy to .env.local for local use,
# or set these values in the frontend build environment on the VPS.
# Production: route /api/v1 to the existing backend through the web server.
# For local development against the VPS, use https://app.domainexprt.com/api/v1.
VITE_API_BASE_URL=/api/v1

# Public landing URL used by login and back-to-website links.
VITE_LANDING_URL=https://app.domainexprt.com

# Must match the redirect URI registered for Google Play OAuth on the backend.
VITE_GOOGLE_PLAY_REDIRECT_URI=https://app.domainexprt.com/api/v1/google-play/callback

# Optional: only for Vite's local /api proxy when VITE_API_BASE_URL=/api/v1.
# VITE_API_PROXY_TARGET=https://app.domainexprt.com
