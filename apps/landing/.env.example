# Landing page build variables (public). Set these during the landing build.
# The canonical public URL used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://app.domainexprt.com

# URL opened by landing page sign-in buttons. For local testing, use
# http://localhost:5173 if the web app runs there.
NEXT_PUBLIC_APP_URL=https://app.domainexprt.com
