{
  "name": "@domainpulse/worker",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL-backed DomainPulse monitoring worker",
  "main": "./dist/worker/src/main.js",
  "scripts": {
    "prebuild": "npm run build --workspace=@domainpulse/database",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker/src/main.js",
    "dev": "tsx src/main.ts",
    "pretypecheck": "npm run build --workspace=@domainpulse/database",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace=@domainpulse/database",
    "test": "vitest run --config test/vitest.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0"
  },
  "dependencies": {
    "@domainpulse/database": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13"
  }
}
