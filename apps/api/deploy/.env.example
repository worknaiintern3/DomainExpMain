# Copy to deploy/.env ON THE SERVER ONLY. No real credentials in GitHub/repo.
BACKEND_HOST_PORT=
# Explicit opt-in only after database backup/review; no seeds or resets.
RUN_MIGRATIONS=false

# Both URLs must reach the same PostgreSQL database. URL-encode special characters.
# Runtime role must not have SUPERUSER/BYPASSRLS or own application tables.
DATABASE_URL=postgresql://domainpulse_api:replace-me@db-host:5432/domainpulse?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://domainpulse_owner:replace-me@db-host:5432/domainpulse?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

NODE_ENV=production
# Actual frontend origins; native mobile clients do not need a browser origin.
CORS_ORIGINS=
LOG_LEVEL=info
RATE_LIMIT_MAX=5000
RATE_LIMIT_WINDOW_MS=900000

JWT_ACCESS_TOKEN_AUDIENCE=domainpulse-clients
JWT_ACCESS_TOKEN_ISSUER=https://app.domainexp.info
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_TOKEN_SECRET=replace-me
JWT_ACCESS_TOKEN_TTL_SECONDS=300

# Required at startup. Generate a DIFFERENT key:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_V1=replace-me
PROVIDER_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# Required at startup. Use your frontend's actual registered HTTPS callback.
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://your-web-client.example/auth/google/callback
GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600

# Optional server-only service credentials, for example WHOISFREAKS_API_KEY.
