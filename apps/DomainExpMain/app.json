{
  "expo": {
    "name": "DomainPulse",
    "slug": "domainpulse-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "domainpulse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00040f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domainpulse.mobile",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#00040f",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#00040f"
        }
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#00040f"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#00040f",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#00040f"
        }
      },
      "package": "com.domainpulse.mobile",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00040f",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#00040f"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#38bdf8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a17e35d7-b48f-4816-8485-18119bd4f7c4"
      }
    }
  }
}
