# Runtime mode: development, test, or production.
NODE_ENV=development

# API listener. Keep the local default bound to loopback unless remote access is intentional.
API_HOST=127.0.0.1
API_PORT=4000

# Explicit comma-separated browser origins. Native mobile clients are not governed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supported levels: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# PostgreSQL connection for the API runtime. Replace only in local environment
# or a secret manager; never commit real credentials.
DATABASE_URL=postgresql://domainpulse:change-me@127.0.0.1:5432/domainpulse

# Pool controls. Defaults shown; tune against the deployment connection budget.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional and only for disposable PostgreSQL integration-test databases.
# TEST_DATABASE_URL=postgresql://domainpulse_test:change-me@127.0.0.1:5432/domainpulse_test

# Google OAuth 2.0 / OIDC (Phase 10K). Google is an identity provider only --
# no Google token is ever persisted. Create a Google Cloud "Web application"
# OAuth client with this exact redirect URI registered, then fill these in
# locally only. Never commit real values.
# GOOGLE_OAUTH_CLIENT_ID=replace-me-with-your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=replace-me-with-your-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Seconds an in-flight Google sign-in attempt remains valid (60-1800, default 600).
# GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600

# Versioned AES-256-GCM keys for provider_connections credential envelopes.
# Each value is a base64-encoded 32-byte random key (generate with
# `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`).
# Encryption uses the ACTIVE version; decryption selects the key recorded on
# each row so older keys must be retained after rotation. Never commit real keys.
# PROVIDER_CREDENTIAL_ENCRYPTION_KEY_V1=replace-me-with-base64-32-bytes
# PROVIDER_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# JWT Access Token Configuration (Required by apps/api auth runtime)
# Generate a random 32-byte base64url secret using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_TOKEN_AUDIENCE=domainpulse-clients
JWT_ACCESS_TOKEN_ISSUER=domainpulse-api
JWT_ACCESS_TOKEN_SECRET=replace-me-with-base64url-32-to-64-bytes
JWT_ACCESS_TOKEN_TTL_SECONDS=300

# Find Domain (registrar availability search) uses DomainPulse-owned CENTRAL
# service credentials. Users never connect their own registrar account to
# search; these are separate from per-workspace provider connections above.
# Server-side only, never sent to the frontend or returned by the API. Set
# them in the deployment environment or a secret manager; never commit real
# values. A provider with none of its variables set is reported as
# UNCONFIGURED. A provider with only SOME of its required variables set makes
# the API fail at startup (only variable names are reported, never values).
#
# GoDaddy: production API personal access token with Domains availability access.
# DOMAIN_SEARCH_GODADDY_PAT=replace-me-with-godaddy-service-pat
#
# Namecheap: API access must be enabled on the account and the production
# server's PUBLIC egress IPv4 must be whitelisted in Namecheap.
# DOMAIN_SEARCH_NAMECHEAP_API_USER=replace-me-with-namecheap-api-user
# DOMAIN_SEARCH_NAMECHEAP_API_KEY=replace-me-with-namecheap-api-key
# Optional; defaults to DOMAIN_SEARCH_NAMECHEAP_API_USER.
# DOMAIN_SEARCH_NAMECHEAP_USERNAME=replace-me-with-namecheap-username
# Public IPv4 of the server making the calls (must match the whitelisted IP).
# DOMAIN_SEARCH_NAMECHEAP_CLIENT_IP=203.0.113.10
#
# Cloudflare: API token with Registrar read/check access on the account, plus
# that account's 32-character hexadecimal account id.
# DOMAIN_SEARCH_CLOUDFLARE_API_TOKEN=replace-me-with-cloudflare-service-token
# DOMAIN_SEARCH_CLOUDFLARE_ACCOUNT_ID=replace-me-with-32-hex-character-account-id

# WhoisFreaks Live WHOIS API
# WHOISFREAKS_API_KEY=replace-me-with-whoisfreaks-api-key

