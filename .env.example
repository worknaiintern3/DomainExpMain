# Runtime mode: development, test, or production.
NODE_ENV=development

# API listener: 0.0.0.0 enables both local dev (Web/Admin) and LAN access (Mobile app on physical devices).
API_HOST=0.0.0.0
API_PORT=4000

# Explicit comma-separated browser origins (Web Dashboard + Admin Panel + Expo Web)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Supported levels: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# API Rate Limiting (Default: 5000 requests per 15 min window)
RATE_LIMIT_MAX=5000
RATE_LIMIT_WINDOW_MS=900000

# Primary Database: MongoDB Atlas
# Connection string: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/domainpulse?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=domainpulse
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Find Domain registrar search credentials
DOMAIN_SEARCH_GODADDY_PAT=your_godaddy_pat_key
DOMAIN_SEARCH_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
DOMAIN_SEARCH_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# WhoisFreaks Domain, DNS & IP Intelligence API Key
WHOISFREAKS_API_KEY=your_whoisfreaks_api_key

# Local JWT Configuration
JWT_ACCESS_TOKEN_AUDIENCE=domainpulse-local-web
JWT_ACCESS_TOKEN_ISSUER=domainpulse-local-api
JWT_ACCESS_TOKEN_SECRET=your_32_to_64_byte_base64url_secret
JWT_ACCESS_TOKEN_TTL_SECONDS=2592000

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600

# Provider credential encryption (AES-256-GCM 32-byte base64 key)
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_V1=your_32_byte_base64_encryption_key
PROVIDER_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1
